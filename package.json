{
  "name": "voyajes",
  "private": true,
  "version": "0.1.0",
  "description": "Voyajes — photos to films, with feeling. Color & motion-first templated video for humans and robots.",
  "scripts": {
    "dev": "pnpm --filter @voyajes/web dev",
    "build": "pnpm -r run build",
    "build:core": "pnpm --filter @voyajes/core build",
    "build:cli": "pnpm --filter @voyajes/cli build",
    "build:web": "pnpm --filter @voyajes/web build",
    "voyajes": "pnpm --filter @voyajes/cli start",
    "lint": "pnpm -r run lint --if-present"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
