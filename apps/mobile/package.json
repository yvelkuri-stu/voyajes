{
  "name": "@voyajes/mobile",
  "version": "1.2.1",
  "private": true,
  "description": "Voyajes native store apps (Capacitor iOS + Android) wrapping apps/web",
  "scripts": {
    "build:web": "cd ../web && VITE_BASE_PATH=/ VITE_PUBLIC_URL=${VOYAJES_PUBLIC_URL:-https://yvelkuri-stu.github.io/voyajes} VITE_NATIVE=1 pnpm exec vite build --outDir ../mobile/www --emptyOutDir",
    "sync": "pnpm build:web && cap sync",
    "android:debug": "bash scripts/build-android.sh debug",
    "android:release": "bash scripts/build-android.sh release"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3"
  }
}
