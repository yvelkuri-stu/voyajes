# Copy to apps/web/.env (Vite only loads env from the app package root)
#   cp .env.example apps/web/.env
# Then restart `pnpm dev`. Never commit real secrets.
#
# Client IDs are public-ish (they ship in the browser). Client *secrets*
# belong on a backend only — do NOT put secrets in VITE_* vars.
#
# Full walkthrough: SETUP_AUTH.md

# Optional override (defaults to current origin + /auth/callback)
# Local:  http://localhost:5173/auth/callback
# Pages:  https://yvelkuri-stu.github.io/voyajes/auth/callback
# VITE_AUTH_REDIRECT_URI=http://localhost:5173/auth/callback

VITE_AUTH_GOOGLE_CLIENT_ID=
VITE_AUTH_APPLE_CLIENT_ID=
VITE_AUTH_MICROSOFT_CLIENT_ID=
VITE_AUTH_META_CLIENT_ID=
VITE_AUTH_GITHUB_CLIENT_ID=

# —— Future OTP / QR (server-side only — do NOT prefix with VITE_ except public bot username) ——
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
# TWILIO_FROM_NUMBER=
# WHATSAPP_PROVIDER=twilio
# WHATSAPP_FROM_NUMBER=
# META_WHATSAPP_TOKEN=
# META_WHATSAPP_PHONE_NUMBER_ID=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# VITE_TELEGRAM_BOT_USERNAME=
# VITE_AUTH_QR_API=
