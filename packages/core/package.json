{
  "name": "@voyajes/core",
  "version": "0.1.0",
  "description": "Voyajes project schema, theme types, and design tokens",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
